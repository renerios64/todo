server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Pass API requests to the backend.
    # API_URL is injected at container startup via envsubst (see docker-entrypoint.sh).
    # In Docker Compose, set API_URL=http://api:8080. In Azure, set it to the internal FQDN.
    location /api/ {
        proxy_pass ${API_URL};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # For any route that doesn't match a real file, serve index.html.
    # This is what makes React Router work — the browser gets index.html,
    # React boots up, reads the URL, and renders the right page.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
